# CLOUDINARY - Donde subes las imágenes generadas
CLOUDINARY_CLOUD=dswrrm5u1
CLOUDINARY_KEY=tu_cloudinary_api_key_aqui
CLOUDINARY_SECRET=tu_cloudinary_api_secret_aqui

# SHOPIFY - Para crear páginas automáticamente
SHOPIFY_STORE=tu-tienda.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# WHATSAPP - Número default para botones (sin 52 al inicio)
DEFAULT_WHATSAPP=5251234567890

# POLLINATIONS - Ya viene en el código, no necesita configuración
# API gratis: https://image.pollinations.ai/prompt/[tu-prompt-aqui]

# ENVIRONMENT
NODE_ENV=production
DEBUG=false
